__yeezy_cd () {
   command -b cd "$@"
}

__yeezy_oldpwd="${PWD}"

__yeezy_hook() {
   if [ "${__yeezy_oldpwd}" != "${PWD}" ]; then
      __yeezy_oldpwd="${PWD}"
      yeezy add ${PWD}
   fi
}

yz () {
   if [ "$#" -eq 0 ]; then
      __yeezy_cd "${HOME}"
   elif [ "$#" -eq 1 ] && [ "$1" = "-" ]; then
      if [ -n "${OLDPWD}" ]; then
         __yeezy_cd "${OLDPWD}"
      fi
   elif [ "$#" -eq 1 ] && [ "$1" = ".." ]; then
      __yeezy_cd ..
   elif [ "$#" -eq 1 ] && [ -d "$1" ]; then
      __yeezy_cd "$1"
   else
      __yeezy_cd "$(yeezy query $@)"
   fi
}

POST_PROMPT_COMMAND=__yeezy_hook
alias y='yz'
